{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2018", "DOM"],
    "types": [],
    "allowJs": false,
    "isolatedModules": true,
    "noUnusedLocals": false
  },
  "include": ["src/**/*.ts"]
}
